# ─── Ollama (LLM) ────────────────────────────────────────────────────────────
OLLAMA_HOST=http://192.168.0.102:11434
VISION_MODEL=llava-phi3
TEXT_MODEL=llama3.2

# ─── YouTube Data API ─────────────────────────────────────────────────────────
# Get a free key at: https://console.cloud.google.com/ → Enable "YouTube Data API v3"
YOUTUBE_API_KEY=your_youtube_api_key_here

# ─── Pricing Formula ──────────────────────────────────────────────────────────
# Change these numbers to adjust how prices are calculated — no code changes needed.

# Your target hourly wage (₹ per hour)
HOURLY_RATE=150

# Average cost of yarn per meter (₹/m)
# Tip: weigh a full ball, measure its length, divide price by length
YARN_COST_PER_METER=0.80

# Fixed overhead per item: packaging, safety eyes, stuffing, thread, etc. (₹)
FIXED_OVERHEAD=50

# Markup multiplier applied on top of total cost
# 1.5 = 50% profit margin, 2.0 = 100% (double cost), 2.5 = 150% etc.
MARKUP_MULTIPLIER=2.0

# Minimum price floor — never suggest below this (₹)
MIN_PRICE=200

# ─── FastAPI Server ───────────────────────────────────────────────────────────
# Port the Python estimator API listens on
API_PORT=8001
