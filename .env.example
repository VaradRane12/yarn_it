COMPANY_NAME="Vercel Inc."
SITE_NAME="Next.js Commerce"

# local | supabase
COMMERCE_PROVIDER="local"

# Supabase (required when COMMERCE_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Revalidation webhook secret
COMMERCE_REVALIDATION_SECRET=""

# Optional legacy var still recognized by revalidate route
SHOPIFY_REVALIDATION_SECRET=""

# Admin UI
ADMIN_PASSWORD="changeme"

# UPI checkout
UPI_VPA="yourname@bank"
UPI_PAYEE_NAME="Crochet Shop"
UPI_TRANSACTION_NOTE="Order payment"

# Estimate emails (Resend). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Yarn it <hello@yarnit.store>"
NEXT_PUBLIC_OWNER_EMAIL=

# Razorpay (test keys: rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
